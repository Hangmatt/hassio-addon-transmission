{
    "name": "Transmission",
    "version": "0.1.1",
    "slug": "transmission",
    "description": "The torrent client for Hass.io with OpenVPN support",
    "url": "https://github.com/Hangmatt/hassio-addon-transmission",
    "webui": "http://[HOST]:[PORT:9091]/transmission/web/",
    "watchdog": "http://[HOST]:8099/",
    "startup": "services",
    "init": false,
    "ingress": true,
    "ingress_port": 8099,
    "panel_icon": "mdi:progress-download",
    "arch": [
        "aarch64",
        "amd64"
    ],
    "map": [
        "app_config:ro",
        "media:rw"
    ],
    "boot": "auto",
    "ports": {
        "9091/tcp": 9091,
        "51413/tcp": 51413,
        "51413/udp": 51413
    },
    "ports_description": {
        "9091/tcp": "Web UI port (Not required for Hass.io Ingress)",
        "51413/tcp": "Peer port (setup port forwarding to this port)",
        "51413/udp": "Peer port (setup port forwarding to this port)"
    },
    "privileged": [
        "NET_ADMIN"
    ],
    "devices": [
        "/dev/net/tun"
    ],
    "hassio_api": true,
    "homeassistant_api": false,
    "host_network": false,
    "options": {
        "log_level": "debug",
        "authentication_required": false,
        "username": "",
        "password": "",
        "direct_access": false,
        "download_dir": "/media/Downloads",
        "incomplete_dir": "/media/Downloads/incomplete",
        "openvpn_enabled": false,
        "openvpn_config": "nl",
        "openvpn_username": "",
        "openvpn_password": ""
    },
    "schema": {
        "log_level": "match(^(trace|debug|info|notice|warning|error|fatal)$)",
        "authentication_required": "bool",
        "username": "str",
        "password": "str",
        "direct_access": "bool",
        "download_dir": "match(^\/media)",
        "incomplete_dir": "match(^\/media)",
        "openvpn_enabled": "bool",
        "openvpn_config": "str",
        "openvpn_username": "str",
        "openvpn_password": "str"
    },
    "environment": {
        "LOG_FORMAT": "{LEVEL}: {MESSAGE}"
    }
}
