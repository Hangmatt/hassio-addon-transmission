#!/bin/sh
set -eu

rpc_status=$(/usr/bin/curl -sS -o /dev/null -w '%{http_code}' \
    http://127.0.0.1:9091/transmission/rpc || true)
case "${rpc_status}" in
    200|401|409) ;;
    *) exit 1 ;;
esac

pidof nginx >/dev/null

if jq -e '.openvpn_enabled == true' /data/options.json >/dev/null 2>&1; then
    pidof openvpn >/dev/null
    test -s /run/transmission/vpn-ip
fi
