#!/usr/bin/with-contenv bashio
# ==============================================================================
# Runs OpenVPN. Transmission is supervised separately and follows the VPN state.
# ==============================================================================
if ! bashio::config.true 'openvpn_enabled'; then
    exec tail -f /dev/null
fi

bashio::log.info "Starting OpenVPN..."

exec /usr/sbin/openvpn \
    --config /etc/openvpn/config.ovpn \
    --script-security 2 \
    --up /etc/openvpn/up-transmission.sh \
    --down /etc/openvpn/down-transmission.sh
